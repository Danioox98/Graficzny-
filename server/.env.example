# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./database.sqlite

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS - Zmień na właściwą domenę w produkcji
# Development: http://localhost:5173
# Production VPS: https://twoja-domena.pl
# Production Render: https://twoj-frontend.onrender.com
CORS_ORIGIN=http://localhost:5173

# Optional: Access Control (dla Allegro)
# Odkomentuj i ustaw własny kod dla kontroli dostępu
# ACCESS_CODE=DRUK2024

# Optional: JWT Secret (jeśli dodajesz system kont)
# JWT_SECRET=twoj-super-tajny-klucz-zmien-to
